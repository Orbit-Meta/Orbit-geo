# --- Google Maps Platform ---------------------------------------------------
# Browser key: Maps JavaScript API + Places API (New). Restrict by HTTP referrer
# (http://localhost:*/*, https://*.ngrok-free.app/*, https://*.trycloudflare.com/*).
GOOGLE_MAPS_API_KEY=
# Vector Map ID with Tilt + Rotation enabled (Cloud Console → Map Management).
GOOGLE_MAP_ID=
# Optional: a separate server key for the Routes API (restricted by API, not by
# referrer). Falls back to GOOGLE_MAPS_API_KEY when empty.
GOOGLE_SERVER_API_KEY=
# DRIVE | TWO_WHEELER | BICYCLE | WALK | TRANSIT
TRAVEL_MODE=DRIVE
# imperial | metric
UNITS=imperial

# --- Discord ----------------------------------------------------------------
DISCORD_WEBHOOK_URL=

# --- Muse Spark (AI phrasing). Leave empty to use the built-in templates. ----
MUSE_API_KEY=
MUSE_API_URL=

# --- OwnTracks HTTP basic auth (shared by every phone) ----------------------
OWNTRACKS_USER=orbit
OWNTRACKS_PASS=change-me

# --- Optional ---------------------------------------------------------------
PORT=3000
# Protects the dashboard + API with basic auth (user "orbit") when exposed through a tunnel.
DASHBOARD_PASS=
# Extra metres beyond the 75 m geofence before a person counts as having left a stop.
GEOFENCE_EXIT_BUFFER_M=10
