{
  "name": "orbit-transit-sync",
  "version": "0.1.0",
  "private": true,
  "description": "Meta Orbit — Transit Sync & ETA dashboard: live OwnTracks locations, multi-stop ETAs, drift, and AI group updates.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "demo": "vite build && node server/index.js",
    "test": "node --test \"server/test/*.test.js\""
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.8.1",
    "vite": "^5.4.11"
  }
}
